# MedFlow Dashboard Environment Variables
# NOTE: All VITE_* variables are embedded into the client-side bundle at build time.
# NEVER store secrets, database passwords, or private API keys here.

# Backend API URL (Production HTTPS / Local HTTP)
# Examples:
#   Production:  https://your-backend.onrender.com
#   Local dev:   http://localhost:8000
#   Android AVD: http://10.0.2.2:8000
VITE_API_URL=https://your-backend.onrender.com

# Optional Supabase Telemetry Sync (Public project URL and anon key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
